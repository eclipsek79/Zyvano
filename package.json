{
  "name": "zyvano",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-platform AI creative-production platform",
  "engines": {
    "node": "22.19.0",
    "pnpm": "10.15.1"
  },
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules pnpm-lock.yaml",
    "validate": "node scripts/validate.mjs",
    "validate:repo": "node scripts/validate-repo.mjs",
    "validate:deps": "node scripts/validate-deps.mjs",
    "db:migrate": "uv run --directory backend alembic -c ../../database/alembic.ini upgrade head",
    "db:revision": "uv run --directory backend alembic -c ../../database/alembic.ini revision --autogenerate",
    "db:downgrade": "uv run --directory backend alembic -c ../../database/alembic.ini downgrade -1",
    "db:history": "uv run --directory backend alembic -c ../../database/alembic.ini history",
    "backend:dev": "uv run --directory backend uvicorn src.main:app --reload --host 0.0.0.0 --port 8000"
  },
  "devDependencies": {
    "turbo": "^2.0.11",
    "typescript": "^5.8.3"
  }
}
